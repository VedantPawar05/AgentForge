# ==========================================
# AgentForge Environment Configuration
# Copy this file to .env for local development
# ==========================================

# Environment & Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentforge_dev?schema=public"

# Redis & BullMQ
REDIS_URL="redis://localhost:6379"
BULLMQ_CONCURRENCY=5

# Authentication (Clerk)
# For local development with mock auth, set AUTH_PROVIDER=mock
AUTH_PROVIDER=mock
CLERK_SECRET_KEY="sk_test_mock_clerk_secret_key"
CLERK_PUBLISHABLE_KEY="pk_test_mock_clerk_publishable_key"
CLERK_WEBHOOK_SECRET="whsec_mock_clerk_webhook_secret"

# S3 / MinIO Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="agentforge-artifacts"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true

# GitHub App Integration
GITHUB_APP_ID="123456"
GITHUB_APP_CLIENT_ID="mock_client_id"
GITHUB_APP_CLIENT_SECRET="mock_client_secret"
GITHUB_APP_PRIVATE_KEY_PATH="./certs/github-app.private-key.pem"
GITHUB_WEBHOOK_SECRET="mock_webhook_secret"

# AI Coding Agent Provider
# Options: mock, anthropic, gemini, openai
AGENT_PROVIDER=mock
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Code Execution Sandbox
# Options: mock, docker, e2b
SANDBOX_DRIVER=mock
DOCKER_SANDBOX_IMAGE="agentforge/sandbox-node:latest"
E2B_API_KEY=""

# Execution Quotas & Guardrails
MAX_TASK_EXECUTION_SECONDS=600
MAX_WORKSPACE_CONCURRENT_RUNS=2
MAX_RUN_RETRIES=2
